generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameState {
  INIT
  J2JOINED
  DEPLOYED
  J2PLAYED
  J1WON
  J2WON
  DRAW
  J1TIMEDOUT
  J2TIMEDOUT
}

model Game {
  id              Int       @id @default(autoincrement())
  state           GameState @default(DEPLOYED)
  chainId         Int
  contractAddress String
  j1Address       String
  j2Address       String
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@unique([chainId, contractAddress])
}
