{
  "name": "rpsls",
  "packageManager": "yarn@4.5.3",
  "scripts": {
    "compileContracts": "yarn workspace @rpsls/contract compile",
    "client:dev": "yarn workspace @rpsls/client dev",
    "client:build": "yarn workspace @rpsls/client build",
    "server:dev": "yarn workspace @rpsls/server dev",
    "server:start": "yarn workspace @rpsls/server start",
    "server:build": "yarn workspace @rpsls/server build",
    "start": "yarn compileContracts && yarn client:build && yarn server:build && yarn server:start"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "ts-node": "^10.9.2"
  },
  "resolutions": {
    "@wagmi/connectors": "6.2.0",
    "elliptic": "^6.6.1",
    "pbkdf2": "^3.1.3",
    "sha.js": "^2.4.12",
    "handlebars": "^4.7.9",
    "postcss": "^8.5.10",
    "js-yaml@npm:3.x": "^3.15.0",
    "js-yaml@npm:^4.1.0": "^4.3.2",
    "brace-expansion@npm:^1.1.7": "^1.1.18",
    "brace-expansion@npm:^2.0.1": "^2.0.2",
    "undici@npm:^5.14.0": "^5.29.0",
    "fast-uri@npm:^3.0.1": "^3.1.2",
    "h3@npm:^1.13.0": "^1.15.9",
    "tar@npm:^7.4.3": "^7.5.22",
    "cookie@npm:^0.4.1": "^0.7.0",
    "body-parser": "^1.20.6",
    "path-to-regexp@0.1.12": "^0.1.13"
  }
}
