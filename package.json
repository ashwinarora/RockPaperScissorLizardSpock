{
  "name": "rpsls",
  "packageManager": "yarn@4.5.3",
  "scripts": {
    "compileContracts": "yarn workspace @rpsls/contract compile",
    "client:dev": "yarn workspace @rpsls/client dev",
    "client:build": "yarn workspace @rpsls/client build",
    "server:dev": "yarn workspace @rpsls/server dev",
    "server:start": "yarn workspace @rpsls/server start",
    "server:build": "yarn workspace @rpsls/server build",
    "start": "yarn compileContracts && yarn client:build && yarn server:build && yarn server:start"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "react-icons": "^5.5.0"
  }
}
